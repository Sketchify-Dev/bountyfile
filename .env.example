# Copy to .env for live Gibwork operations. Never commit .env.
# Keep this file safe: it holds access to real funds. chmod 600 .env

# Offline demo (no keys needed):
GIBWORK_MOCK=true

# Live mode (stage by default; GIBWORK_PROD=true for production):
# Preferred: same key the official CLI uses (export from the Gibwork mobile app).
# GIBWORK_PRIVATE_KEY=base58-or-json-array
# Also accepted (SDK style):
# SOLANA_PRIVATE_KEY=base58-or-json-array
# GIBWORK_PROD=false
